QMainWindow {
    background-color: #1A1A1A;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 1px solid #3A3A3A;
    margin: 5px;
}

QPushButton {
    background-color: #2E2E2E;
    border: 1px solid #4A4A4A;
    padding: 8px;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #3E3E3E;
}